<Window x:Class="BinPackingApp.MainWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:BinPackingApp"
    Title="Двумерная упаковка"
    Width="1100"
    Height="820"
    MinWidth="900"
    MinHeight="700"
    Background="#F4F5F7"
    Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0">
            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="StartButton"
                    Content="Запустить"
                    Click="Start_Click" />

                <Button
                    x:Name="StopButton"
                    Grid.Column="2"
                    Content="Остановить"
                    Click="Stop_Click"
                    IsEnabled="False" />
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="InputPanel">
                    <TextBlock
                        Text="Количество фигур"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8" />

                    <ItemsControl x:Name="PartsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="{Binding Size}"
                                        VerticalAlignment="Center" />

                                    <TextBox
                                        Grid.Column="1"
                                        Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Text="Параметры поиска"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Популяция" VerticalAlignment="Center" />
                        <TextBox x:Name="PopulationBox" Grid.Column="1" Text="80" />

                        <TextBlock
                            Grid.Row="1"
                            Text="Поколения"
                            VerticalAlignment="Center" />

                        <TextBox
                            x:Name="GenerationsBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="300" />

                        <TextBlock
                            Grid.Row="2"
                            Text="Мутация (0;1)"
                            VerticalAlignment="Center" />

                        <TextBox
                            x:Name="MutationBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="0,25" />
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="240" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,12">
                <TextBlock
                    x:Name="ResultText"
                    Text="Результат ещё не рассчитан"
                    FontSize="19"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="ProgressText"
                    Text="Введите данные и нажмите «Запустить»."
                    Foreground="#64748B"
                    Margin="0,6,0,0"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Background="White"
                BorderBrush="#D6DAE1"
                BorderThickness="1">

                <local:PackingCanvas x:Name="Scene" />
            </Border>

            <GroupBox
                Grid.Row="2"
                Header="Приспособленность: площадь и периметр (последние 200 поколений)"
                Background="White"
                Padding="8"
                Margin="0,12,0,0">

                <local:FitnessChart x:Name="Chart" />
            </GroupBox>
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Text="Готово к запуску."
            Foreground="#475569"
            TextWrapping="Wrap"
            Margin="0,12,0,0" />
    </Grid>
</Window>
